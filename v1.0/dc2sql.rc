#include <winres.h>

// Define core resource constants explicitly for the compiler
#define IDI_APP_ICON 101

// 1. APPLICATION VISUAL ICON MAPPING
IDI_APP_ICON ICON "favicon.ico"

// 2. OFFICIAL WINDOWS FILE VERSIONING INFRASTRUCTURE
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // Language: US English (0x0409), Character Set: Unicode (0x04B0)
        BEGIN
            VALUE "CompanyName",      "Mercwar AI\0"
            VALUE "FileDescription",  "dc2sql Core Library\0" // Change to "dc2jet Database Engine Component" for dc2jet.dll
            VALUE "FileVersion",      "1.1.0.0\0"
            VALUE "InternalName",     "dc2sql\0"              // Change to "dc2jet" for dc2jet.dll
            VALUE "LegalCopyright",   "Copyright (C) 2026 Joseph Michael Catalano, Mercwar AI. All rights reserved.\0"
            VALUE "OriginalFilename", "dc2sql.dll\0"          // Change to "dc2jet.dll" for dc2jet.dll
            VALUE "ProductName",      "dc2sql Suite\0"
            VALUE "ProductVersion",   "1.1\0"
            VALUE "Comments",         "Database provider bridging library for Windows.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END